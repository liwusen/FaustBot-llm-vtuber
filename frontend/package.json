{
  "name": "faust-live2d-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "electron-main.js",
  "license": "MIT",
  "author": "allenlee",
  "description": "Faust Live2D frontend application",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.allenlee.live2dfrontend",
    "productName": "FaustLive2DFrontend",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "app.js",
      "styles.css",
      "config-window.html",
      "config-window.css",
      "config-window.js",
      "libs/**/*",
      "package.json",
      "live-window.html",
      "live-window.css",
      "live-window.js"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
