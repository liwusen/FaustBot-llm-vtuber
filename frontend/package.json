{
  "name": "faust-frontend",
  "version": "2.0.0",
  "private": true,
  "main": "electron-main.js",
  "license": "MIT",
  "author": "allenlee",
  "description": "FaustBot frontend application",
  "scripts": {
    "start": "electron .",
    "build:bundle": "esbuild libs/configer/.codemirror-entry.js --bundle --platform=browser --format=iife --outfile=libs/codemirror/codemirror-bundle.js --minify-syntax",
    "package": "npm run build:bundle && electron-builder --win dir",
    "check-js": "node scripts/check-js-syntax.js"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.2",
    "three": "^0.184.0",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.allenlee.live2dfrontend",
    "productName": "FaustLive2DFrontend",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "index.html",
      "app.js",
      "vrm-renderer.js",
      "styles.css",
      "config-window.html",
      "config-window.css",
      "config-window.js",
      "libs/**/*",
      "package.json",
      "live-window.html",
      "live-window.css",
      "live-window.js",
      "FaustBot.icon.tiny.png"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
