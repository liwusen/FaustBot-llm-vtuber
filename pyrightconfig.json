{
  "include": ["backend"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".runtime",
    ".nodejs",
    "frontend",
    "backend/tts-hub", "**/.*"
  ],
  "venvPath": ".",
  "venv": ".runtime",
  "pythonVersion": "3.11",
  "typeCheckingMode": "off",
  "useLibraryCodeForTypes": true,
  "reportMissingTypeStubs": "none",
  "reportMissingImports": "error",
  "executionEnvironments": [
    {
      "root": "backend/tests",
      "extraPaths": ["backend", "backend/default_plugins/agile-engine"]
    }
  ]
}
