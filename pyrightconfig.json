{
  "include": ["backend"],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".runtime",
    ".nodejs",
    "frontend",
    "backend/tts-hub", "**/.*",
    "backend/faust_backend/vendor"
  ],
  "extraPaths": ["backend/faust_backend/vendor"],
  "venvPath": ".runtime",
  "venv": ".",
  "pythonVersion": "3.11",
  "typeCheckingMode": "off",
  "useLibraryCodeForTypes": true,
  "reportMissingTypeStubs": "none",
  "reportMissingImports": "error",
  "executionEnvironments": [
    {
      "root": "backend/tests",
      "extraPaths": ["backend", "backend/default_plugins/agile-engine", "backend/default_plugins/desktop-mood"]
    },
    {
      "root": "backend/default_plugins/desktop-mood",
      "extraPaths": ["backend", "backend/default_plugins/desktop-mood"]
    }
  ]
}
